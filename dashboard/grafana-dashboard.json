{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "WebTransport4J Executive Health & SLOs",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 99.9 },
              { "color": "green", "value": 99.99 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Availability SLO (Target: 99.99%)",
      "type": "stat",
      "targets": [
        {
          "expr": "100 - (sum(rate(webtransport_sessions_closed_total{status!=\"0\"}[5m])) / sum(rate(webtransport_sessions_opened_total[5m])) * 100)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Active WebTransport Sessions",
      "type": "stat",
      "targets": [
        { "expr": "sum(webtransport_sessions_active)", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "pps"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Datagram Rate (Packets/Sec)",
      "type": "stat",
      "targets": [
        { "expr": "sum(rate(webtransport_datagrams_sent_total[1m]))", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Netty Leaks (PARANOID)",
      "type": "stat",
      "targets": [
        { "expr": "webtransport_netty_buffer_leaks_total or vector(0)", "refId": "A" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Transport & Stream Multiplexing",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 20, "lineWidth": 2, "spanNulls": false }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "title": "Active Sessions & Streams Dynamics",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(webtransport_sessions_active)", "legendFormat": "Active Sessions", "refId": "A" },
        { "expr": "sum(webtransport_streams_active)", "legendFormat": "Active Streams", "refId": "B" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 15, "lineWidth": 2 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "title": "QUIC RTT Latency Distribution",
      "type": "timeseries",
      "targets": [
        { "expr": "webtransport_quic_rtt_seconds{quantile=\"0.5\"}", "legendFormat": "Mean RTT", "refId": "A" },
        { "expr": "webtransport_quic_rtt_seconds{quantile=\"0.99\"}", "legendFormat": "P99 RTT", "refId": "B" }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["webtransport", "quic", "http3", "opentelemetry", "networking"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["1s", "5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "WebTransport4J - Production Cluster Overview",
  "uid": "wt4j-prod-cluster"
}
