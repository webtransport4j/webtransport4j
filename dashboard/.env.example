# Copy to .env on the deployment host; populate secrets there.
WT4J_ADMIN_USERNAME=operations
WT4J_ADMIN_PASSWORD=
WT4J_NODE_MANAGEMENT_TOKEN=
WT4J_OTLP_TOKEN=
WT4J_CLUSTER_NODES=https://node-1.example.com:8080,https://node-2.example.com:8080
WT4J_PROMETHEUS_TARGETS=http://otel-collector:8889/metrics
WT4J_TLS_DIR=/etc/webtransport-dashboard/tls
WT4J_PORTAL_BIND_IP=0.0.0.0
WT4J_PORTAL_PORT=8443
