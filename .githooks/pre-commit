#!/usr/bin/env bash
# ==============================================================================
# WebTransport4J - Pre-Commit Integrity Hook
# Enforces security, code hygiene, Google Java Style, and multi-release compilation.
# ==============================================================================
set -euo pipefail

# ANSI color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# ------------------------------------------------------------------------------
# 0. Delegate to pre-commit framework if available and configured
# ------------------------------------------------------------------------------
if [ -z "${PRE_COMMIT_FORCE_NATIVE:-}" ] && [ -f ".pre-commit-config.yaml" ]; then
    if command -v pre-commit > /dev/null 2>&1; then
        exec pre-commit run --hook-stage pre-commit
    elif python3 -m pre_commit --version > /dev/null 2>&1; then
        exec python3 -m pre_commit run --hook-stage pre-commit
    fi
fi

# ------------------------------------------------------------------------------
# Fallback: Standalone native pre-commit integrity checks
# ------------------------------------------------------------------------------
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BOLD}🔒 WebTransport4J Pre-Commit Integrity Shield (Native)${NC}"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

# Identify staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}[PASS]${NC} No staged files to check."
    exit 0
fi

FAILED=0

# ------------------------------------------------------------------------------
# 1. Prohibited Certificate & Key File Check
# WebTransport4J enforces dynamic test certificate generation.
# No TLS certificates, keys, or keystores may ever be committed to git.
# ------------------------------------------------------------------------------
FORBIDDEN_CERT_FILES=$(echo "$STAGED_FILES" | grep -E '\.(pem|key|pkcs8|p12|pfx|crt|der)$' || true)
if [ -n "$FORBIDDEN_CERT_FILES" ]; then
    echo -e "${RED}[FAIL] Prohibited certificate / private key file(s) staged:${NC}"
    echo "$FORBIDDEN_CERT_FILES" | while IFS= read -r f; do echo -e "  ${RED}✗${NC} $f"; done
    echo -e "  ${YELLOW}Policy:${NC} Test certificates must be generated dynamically on the fly"
    echo -e "          via io.github.webtransport4j.test.TestCertificates."
    echo -e "          Never commit static certificates or private keys."
    FAILED=1
fi

# ------------------------------------------------------------------------------
# 2. Secret & Private Key Content Detection in Staged Diffs
# ------------------------------------------------------------------------------
KEY_HEADER="BEGIN"
KEY_FOOTER="PRIVATE KEY"
if git diff --cached -S"${KEY_HEADER} ${KEY_FOOTER}" --name-only | grep -q . || \
   git diff --cached -S"${KEY_HEADER} RSA ${KEY_FOOTER}" --name-only | grep -q . || \
   git diff --cached -S"${KEY_HEADER} EC ${KEY_FOOTER}" --name-only | grep -q . || \
   git diff --cached -S"${KEY_HEADER} OPENSSH ${KEY_FOOTER}" --name-only | grep -q . || \
   git diff --cached -S"${KEY_HEADER} DSA ${KEY_FOOTER}" --name-only | grep -q .; then
    echo -e "${RED}[FAIL] Detected private key content block in staged changes!${NC}"
    FAILED=1
fi

# ------------------------------------------------------------------------------
# 3. Merge Conflict Markers Check
# ------------------------------------------------------------------------------
CONFLICT_FILES=$(git diff --cached -G'^[<>=]{7}( |$)' --name-only || true)
if [ -n "$CONFLICT_FILES" ]; then
    echo -e "${RED}[FAIL] Unresolved merge conflict markers detected in:${NC}"
    echo "$CONFLICT_FILES" | while IFS= read -r f; do echo -e "  ${RED}✗${NC} $f"; done
    FAILED=1
fi

# ------------------------------------------------------------------------------
# 4. OS & Editor Junk Files Check
# ------------------------------------------------------------------------------
JUNK_FILES=$(echo "$STAGED_FILES" | grep -E '(\.DS_Store|Thumbs\.db|\.orig$|\.rej$|~$|\.swp$)' || true)
if [ -n "$JUNK_FILES" ]; then
    echo -e "${RED}[FAIL] Prohibited temporary / OS junk file(s) staged:${NC}"
    echo "$JUNK_FILES" | while IFS= read -r f; do echo -e "  ${RED}✗${NC} $f"; done
    FAILED=1
fi

# ------------------------------------------------------------------------------
# 5. File Size Safety Check (Limit: 500 KB)
# ------------------------------------------------------------------------------
MAX_FILE_SIZE_KB=500
LARGE_FILES=""
while IFS= read -r file; do
    [ -z "$file" ] && continue
    if [ -f "$file" ]; then
        file_size_bytes=$(wc -c < "$file" 2>/dev/null || stat -f%z "$file" 2>/dev/null || echo 0)
        file_size_kb=$((file_size_bytes / 1024))
        if [ "$file_size_kb" -gt "$MAX_FILE_SIZE_KB" ]; then
            LARGE_FILES="${LARGE_FILES}\n  ${RED}✗${NC} $file (${file_size_kb} KB > ${MAX_FILE_SIZE_KB} KB)"
        fi
    fi
done <<< "$STAGED_FILES"

if [ -n "$LARGE_FILES" ]; then
    echo -e "${RED}[FAIL] Staged file(s) exceed maximum allowed size (${MAX_FILE_SIZE_KB} KB):${NC}"
    echo -e "$LARGE_FILES"
    FAILED=1
fi

# ------------------------------------------------------------------------------
# 6. Native Git Whitespace / Formatting Check
# ------------------------------------------------------------------------------
if ! git diff --cached --check > /dev/null 2>&1; then
    echo -e "${RED}[FAIL] Staged changes contain whitespace or formatting errors:${NC}"
    git diff --cached --check | head -n 20
    FAILED=1
fi

# ------------------------------------------------------------------------------
# 7. Non-Java Syntax Validation (JSON and Shell Scripts)
# ------------------------------------------------------------------------------
JSON_FILES=$(echo "$STAGED_FILES" | grep -E '\.json$' || true)
if [ -n "$JSON_FILES" ]; then
    while IFS= read -r jf; do
        [ -z "$jf" ] && continue
        if [ -f "$jf" ]; then
            if ! python3 -m json.tool "$jf" > /dev/null 2>&1; then
                echo -e "${RED}[FAIL] Invalid JSON syntax in: $jf${NC}"
                FAILED=1
            fi
        fi
    done <<< "$JSON_FILES"
fi

SH_FILES=$(echo "$STAGED_FILES" | grep -E '\.sh$' || true)
if [ -n "$SH_FILES" ]; then
    while IFS= read -r sf; do
        [ -z "$sf" ] && continue
        if [ -f "$sf" ]; then
            if ! bash -n "$sf" 2>/dev/null; then
                echo -e "${RED}[FAIL] Shell script syntax error in: $sf${NC}"
                FAILED=1
            fi
        fi
    done <<< "$SH_FILES"
fi

# Abort immediately if hygiene or security rules failed
if [ "$FAILED" -ne 0 ]; then
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED}[ERROR] Pre-commit checks failed! Please resolve violations above.${NC}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    exit 1
fi

# ------------------------------------------------------------------------------
# 8. Java Code Integrity Gates (Checkstyle & Multi-Release Compile)
# ------------------------------------------------------------------------------
JAVA_STAGED=$(echo "$STAGED_FILES" | grep -E '(\.java$|pom\.xml$|config/checkstyle/.*\.xml$)' || true)

if [ -n "$JAVA_STAGED" ]; then
    echo -e "${BLUE}==>${NC} Java source/build changes detected. Running Maven integrity gates..."

    # Gate 1: Checkstyle Verification (Google Java Style)
    echo -e "  ${BLUE}•${NC} Running Google Checkstyle verification..."
    CHECKSTYLE_OUTPUT=$(mvn --batch-mode checkstyle:check 2>&1 || true)
    if echo "$CHECKSTYLE_OUTPUT" | grep -q "You have 0 Checkstyle violations"; then
        echo -e "  ${GREEN}✓${NC} Checkstyle passed with 0 violations."
    else
        echo -e "${RED}[FAIL] Checkstyle violations detected!${NC}"
        echo "$CHECKSTYLE_OUTPUT" | grep -E "(\[ERROR\]|\[WARN\]|violations)" | head -n 30 || echo "$CHECKSTYLE_OUTPUT"
        echo -e "${YELLOW}Hint: Run 'mvn checkstyle:check' locally to view full audit logs.${NC}"
        exit 1
    fi

    # Gate 2: Multi-Release Compilation Gate (javac 8, 11, 25)
    echo -e "  ${BLUE}•${NC} Running multi-release test-compile verification..."
    if ! COMPILE_OUTPUT=$(mvn --batch-mode test-compile -DskipTests 2>&1); then
        echo -e "${RED}[FAIL] Multi-release compilation failed!${NC}"
        echo "$COMPILE_OUTPUT" | tail -n 25
        echo -e "${YELLOW}Hint: Run 'mvn test-compile -DskipTests' locally to debug.${NC}"
        exit 1
    fi
    echo -e "  ${GREEN}✓${NC} Multi-release compilation passed across all Java versions."
fi

echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✓ All pre-commit integrity gates passed! Proceeding with commit.${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
exit 0
